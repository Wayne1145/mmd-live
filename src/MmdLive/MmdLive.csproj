<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MmdLive</AssemblyName>
    <Version>0.1.4</Version>
    <Product>MMD Live</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <Compile Include="../../vendor/Coocoo3D/PMXFormat.cs" Link="Vendor/PMXFormat.cs" />
    <Content
      Include="../../assets/models/*"
      Link="models/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../assets/studio/StudioPilot.pmx"
      Link="studio/StudioPilot.pmx"
      CopyToOutputDirectory="PreserveNewest"
    />
    <InternalsVisibleTo Include="MmdLive.Checks" />
    <EmbeddedResource Include="Rendering/Model.hlsl" />
  </ItemGroup>
  <Target Name="ExcludeNativeDeveloperFiles" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'DirectML.Debug.dll' Or '%(Filename)%(Extension)' == 'DirectML.Debug.pdb' Or '%(Filename)%(Extension)' == 'DirectML.pdb' Or '%(Filename)%(Extension)' == 'onnxruntime.lib'" />
    </ItemGroup>
  </Target>
</Project>
